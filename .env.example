# Copy this file to .env and fill it in. .env is never committed.

# Your business. /learn-business reads the site, the ads target the city.
BUSINESS_NAME=
SITE_BASE_URL=https://
MAIN_CITY=
# Two letters: US, CA, GB, AU, NZ or IE. Every ad library is searched in this country.
COUNTRY=US

# Apify (apify.com > Settings > API & Integrations). Pulls every ad library. A full run costs about $1.
APIFY_TOKEN=
# Optional second token, used when the first runs out of credit.
APIFY_TOKEN_BACKUP=

# DataForSEO (dataforseo.com > API Dashboard). Google ad text and keyword volumes. Cents a run.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Ads API, only for /publish-ads (developers.google.com/google-ads/api/docs/get-started).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Your manager account id if you sign in through one, digits only. Else leave it empty.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# The account the paused campaign goes into, digits only. Its name must contain BUSINESS_NAME.
GOOGLE_ADS_CUSTOMER_ID=
